-- IDENTIFY HOUSEHOLD CO-RESIDENTS

INSERT INTO TABLE_STEP_3A

SELECT 
FORM_ID, 
RESIDENT_ID, 
AGE, 
CO_RESIDENT_FLAG
FROM (
SELECT *, 
1 AS CO_RESIDENT_FLAG, 
ROW_NUMBER() OVER(PARTITION BY RESIDENT_ID ORDER BY RESIDENT_ID DESC) AS RN FROM(
SELECT 
FORM_ID,
RESIDENT_ID,
ROUND(CAST((DAYS('XXXX-XX-XX') - DAYS(WOB)) / 365.25 AS FLOAT),0) AS AGE, 
SEX FROM (
SELECT 
FORM_ID, 
RESIDENT_ID, 
WOB, 
SEX 
FROM TABLE_CENSUS_RESIDENT
WHERE FORM_ID IN (SELECT FORM_ID FROM TABLE_STEP_2)
AND RESIDENT_ID NOT IN (SELECT RESIDENT_ID FROM TABLE_STEP_2))))
WHERE AGE IS NOT NULL AND RN = 1;

-- INCLUDE PARENTS AND CHILDREN

INSERT INTO TABLE_STEP_3B

SELECT 
FORM_ID, 
RESIDENT_ID, 
CHILD_FLAG, 
PARENT_FLAG,
0 AS CO_RESIDENT_FLAG,
AGE
FROM TABLE_STEP_2
UNION ALL
SELECT
FORM_ID,
RESIDENT_ID,
0 AS CHILD_FLAG,
0 AS PARENT_FLAG, 
CO_RESIDENT_FLAG,
AGE
FROM
TABLE_STEP_3A;



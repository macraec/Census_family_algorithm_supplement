INSERT INTO TABLE_STEP_2

SELECT 
RESPONSE_ID, 
RESIDENT_ID, 
PARENT_FLAG, 
CHILD_FLAG, 
AGE 
FROM (
SELECT 
RESPONSE_ID, 
RESIDENT_ID, 
MAX(PARENT_FLAG) OVER (PARTITION BY RESPONSE_ID, RESIDENT_ID) AS PARENT_FLAG,
MAX(CHILD_FLAG) OVER (PARTITION BY RESPONSE_ID, RESIDENT_ID) AS CHILD_FLAG,
MAX(AGE) OVER (PARTITION BY RESPONSE_ID, RESIDENT_ID) AS AGE,
ROW_NUMBER() OVER (PARTITION BY RESPONSE_ID, RESIDENT_ID ORDER BY RESIDENT_ID) AS RN
FROM(
SELECT RESPONSE_ID, PARENT_ID AS RESIDENT_ID, 1 AS PARENT_FLAG, 0 AS CHILD_FLAG, PARENT_AGE AS AGE
FROM TABLE_STEP_1
WHERE PARENT_ID IS NOT NULL
UNION ALL
SELECT RESPONSE_ID, CHILD_ID AS RESIDENT_ID, O AS PARENT_FLAG, 1 AS CHILD_FLAG, CHILD_AGE AS AGE
FROM TABLE_STEP_1
WHERE CHILD_ID IS NOT NULL)) 
WHERE RN=1;

INSERT INTO TABLE_STEP_2

SELECT 
FORM_ID, 
PERSON_ID, 
PARENT_FLAG, 
CHILD_FLAG, 
AGE 
FROM (
SELECT 
FORM_ID, 
PERSON_ID, 
MAX(PARENT_FLAG) OVER (PARTITION BY FORM_ID, PERSON_ID) AS PARENT_FLAG,
MAX(CHILD_FLAG) OVER (PARTITION BY FORM_ID, PERSON_ID) AS CHILD_FLAG,
MAX(AGE) OVER (PARTITION BY FORM_ID, PERSON_ID) AS AGE,
ROW_NUMBER() OVER (PARTITION BY FORM_ID, PERSON_ID ORDER BY PERSON_ID) AS RN
FROM(
SELECT FORM_ID, PARENT_ID AS PERSON_ID, 1 AS PARENT_FLAG, 0 AS CHILD_FLAG, PARENT_AGE AS AGE
FROM TABLE_STEP_1
WHERE PARENT_ID IS NOT NULL
UNION ALL
SELECT FORM_ID, CHILD_ID AS PERSON_ID, O AS PARENT_FLAG, 1 AS CHILD_FLAG, CHILD_AGE AS AGE
FROM TABLE_STEP_1
WHERE CHILD_ID IS NOT NULL)) 
WHERE RN=1;
